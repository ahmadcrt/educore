:root{--navy:#0b1f3a;--navy2:#13305a;--teal:#2a9d9a;--tealbg:#e8f4f3;--grey:#6b7685;--line:#e3e7ec;--bg:#f7f8fa;--r:12px}
*{box-sizing:border-box;margin:0}
body{font:16px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--navy);background:var(--bg)}
h1,h2,h3{font-family:Georgia,"Times New Roman",serif;line-height:1.2}
a{color:inherit}
:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
.wrap{max-width:1100px;margin:0 auto;padding:0 20px}
header.nav{background:var(--navy);color:#fff;position:sticky;top:0;z-index:10}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;min-height:60px;flex-wrap:wrap;gap:8px}
.logo{font-family:Georgia,serif;font-weight:700;font-size:1.3rem;text-decoration:none;letter-spacing:.04em}
.logo span{color:var(--teal)}
.nav nav{display:flex;gap:16px;flex-wrap:wrap;align-items:center}
.nav nav a{text-decoration:none;color:#cfd8e6;font-size:.95rem}
.nav nav a:hover{color:#fff}
.nav nav a.btn{color:#fff}
.btn{display:inline-block;background:var(--teal);color:#fff;border:0;padding:11px 20px;border-radius:8px;font:600 1rem system-ui,sans-serif;cursor:pointer;text-decoration:none;text-align:center;transition:background .2s}
.btn:hover{background:#238583}
.btn.ghost{background:transparent;border:1.5px solid var(--line);color:var(--navy)}
.hero{background:linear-gradient(160deg,var(--navy),var(--navy2));color:#fff;padding:72px 0}
.hero h1{font-size:clamp(2rem,6vw,3.4rem);max-width:15em}
.hero p{color:#cfd8e6;max-width:34em;margin:16px 0 28px}
.search{display:flex;gap:8px;max-width:520px;flex-wrap:wrap}
.search input{flex:1;min-width:200px}
input,select,textarea{width:100%;padding:11px 12px;border:1.5px solid var(--line);border-radius:8px;font:inherit}
section{padding:56px 0}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:20px;margin-top:24px}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:20px;display:flex;flex-direction:column;gap:8px}
.tag{align-self:flex-start;background:var(--tealbg);color:#1d6f6c;font-size:.8rem;padding:2px 10px;border-radius:99px}
.meta{color:var(--grey);font-size:.9rem}
.auth{min-height:100vh;display:grid;place-items:center;padding:20px}
.auth form{background:#fff;padding:32px;border-radius:var(--r);border:1px solid var(--line);width:100%;max-width:400px;display:grid;gap:14px}
label{font-size:.9rem;font-weight:600;display:grid;gap:4px}
.msg{padding:10px 12px;border-radius:8px;font-size:.92rem;display:none}
.msg.err{display:block;background:#fdecec;color:#9b1c1c}.msg.ok{display:block;background:var(--tealbg);color:#1d6f6c}
footer{background:var(--navy);color:#cfd8e6;padding:32px 0;font-size:.9rem}
.demo{font-size:.8rem;color:var(--grey)}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
@media (max-width:600px){.hero{padding:48px 0}section{padding:40px 0}}

